{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The overlay listens and drives its own dictation only.",
  "windows": ["overlay"],
  "permissions": [
    "core:event:allow-listen",
    "allow-overlay-ready",
    "allow-capture-started",
    "allow-capture-finalizing",
    "allow-finish-session",
    "allow-insert-text",
    "allow-start-native-capture",
    "allow-stop-native-capture",
    "allow-mute-warning-shown",
    "allow-dictation-context"
  ]
}
