{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speechek",
  "version": "0.2.0",
  "identifier": "app.speechek.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "girte",
    "homepage": "https://github.com/girte/speechek",
    "copyright": "Copyright (c) 2026 girte",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "English": "nsis/languages/English.nsh",
          "Russian": "nsis/languages/Russian.nsh"
        },
        "compression": "lzma"
      }
    }
  }
}
