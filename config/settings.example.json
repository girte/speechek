// Speechek: локальные настройки (%APPDATA%/Speechek/settings.json; у debug-профилей каталог Speechek-Dev или Speechek-Test).
// Отредактируйте значения в окне настроек или в этом файле и сохраните.
// Строки с // должны быть отдельными; комментарии в конце строки и лишние запятые не поддерживаются.
// API-ключи здесь не хранятся: они шифруются DPAPI текущего пользователя в secrets.bin рядом с этим файлом.
{
  // hotkey: глобальная клавиша включения/выключения записи. Значение ниже —
  // production-умолчание F2; debug-профили при первом запуске пишут сюда своё
  // (Ctrl+Shift+F9 у Development, Ctrl+Shift+F10 у Test) и не трогают
  // остального. Пример сочетания: "Ctrl+Shift+F9". Fn и F12 не поддерживаются.
  // Доступны A–Z, 0–9, F1–F24 (кроме F12), Space, Enter, Tab,
  // стрелки, Home/End, PageUp/PageDown, Insert/Delete/Backspace;
  // перед клавишей можно добавить Ctrl, Alt, Shift или Super через +.
  // Escape без модификаторов не поддерживается: пока идёт диктовка, им
  // отменяется запись (текст никуда не вставляется).
  "hotkey": "F2",

  // mode: один режим обычной диктовки: "live" — текст во время речи,
  // "smart" — обработанный текст после записи, "verbatim" — дословный текст.
  "mode": "live",

  // mute_during_recording: true — на время фактической записи с микрофона
  // отключать общий звук Windows на устройстве воспроизведения по умолчанию
  // (тот же регулятор, что и клавиша mute) и возвращать прежнее состояние
  // после остановки или отмены; вне записи звук не трогается.
  // Если вы сами изменили звук во время записи, Speechek его не перезапишет.
  // Неудачное отключение или возврат не прерывает диктовку: в плашке появится
  // предупреждение «Не удалось отключить звук во время записи».
  "mute_during_recording": false,

  // port: порт внутреннего сервера Speechek на 127.0.0.1, целое число от 1
  // до 65535. Значение ниже — production-умолчание 4173; debug-профили
  // используют 4174 (Development) и 4175 (Test). Новое значение применяется
  // после перезапуска приложения. Если при запуске порт занят, Speechek
  // временно откроется на свободном порту и покажет это в окне настроек, не
  // перезаписывая сохранённое значение.
  "port": 4173,

  // input_device: микрофон для диктовки и встроенной лаборатории.
  // null — системное устройство по умолчанию. Другое устройство выбирается в
  // окне настроек, и сюда записывается его идентификатор. Выбор действует со
  // следующей записи; если устройство отключено, Speechek предупредит и
  // запишет с системного, сохранив прежний идентификатор.
  "input_device": null,

  // language: язык интерфейса окон и плашки — "en" (English) или "ru"
  // (Русский). Значение ниже — шаблонное; при первом запуске Speechek
  // записывает сюда выбранный язык: сохранённый выбор приложения, выбор
  // установщика, язык интерфейса Windows, иначе английский. Переключается в
  // окне настроек и применяется сразу, не влияя на распознавание речи.
  "language": "en"
}
